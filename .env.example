NEXT_PUBLIC_GOOGLE_ADS_ID=    # Google Ads, ex: AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=  # rótulo da conversão "clique no WhatsApp"
NEXT_PUBLIC_META_PIXEL_ID=    # pixel do Meta, só números
